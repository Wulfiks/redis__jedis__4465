FROM eclipse-temurin:8-jdk

RUN _jh="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" && ln -sfn "$_jh" /opt/helix-jdk
ENV JAVA_HOME=/opt/helix-jdk
ENV MAVEN_OPTS=-Xmx1024m

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git maven && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN mvn -B -ntp -Dmaven.test.skip=true -DskipTests package

CMD ["sh", "-c", "mvn -B -ntp test -Dspotless.check.skip=true -Dcheckstyle.skip=true -Dpmd.skip=true -Dcpd.skip=true -Denforcer.skip=true -Dlicense.skip=true -Dformatter.skip=true -Dimpsort.skip=true -Dsort.skip=true -Djacoco.skip=true", "-Dspotless.check.skip=true", "-Dcheckstyle.skip=true", "-Dpmd.skip=true", "-Dcpd.skip=true", "-Denforcer.skip=true", "-Dlicense.skip=true", "-Dformatter.skip=true", "-Dimpsort.skip=true", "-Dsort.skip=true", "-Djacoco.skip=true"]
